<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_meryl_background"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="6dp">

    <ImageView
        android:id="@+id/widget_artwork"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:background="@drawable/widget_meryl_artwork_background"
        android:contentDescription="@string/widget_artwork"
        android:scaleType="centerCrop"
        android:src="@android:drawable/ic_media_play" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginStart="9dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widget_artist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="marquee"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:marqueeRepeatLimit="marquee_forever"
            android:singleLine="true"
            android:text="Aucun artiste"
            android:textColor="#FFFFFFFF"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_album"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:ellipsize="marquee"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:marqueeRepeatLimit="marquee_forever"
            android:singleLine="true"
            android:text="Aucun album"
            android:textColor="#FFFFDE59"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:ellipsize="marquee"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:marqueeRepeatLimit="marquee_forever"
            android:singleLine="true"
            android:text="Aucune lecture"
            android:textColor="#FFE5E9EC"
            android:textSize="11sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="28dp"
            android:layout_marginTop="1dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/widget_previous"
                android:layout_width="38dp"
                android:layout_height="28dp"
                android:background="@android:color/transparent"
                android:contentDescription="@string/widget_previous"
                android:padding="5dp"
                android:src="@android:drawable/ic_media_previous"
                android:tint="#FFFFDE59" />

            <ImageButton
                android:id="@+id/widget_play_pause"
                android:layout_width="38dp"
                android:layout_height="28dp"
                android:background="@android:color/transparent"
                android:contentDescription="@string/widget_play_pause"
                android:padding="5dp"
                android:src="@android:drawable/ic_media_play"
                android:tint="#FFFFDE59" />

            <ImageButton
                android:id="@+id/widget_next"
                android:layout_width="38dp"
                android:layout_height="28dp"
                android:background="@android:color/transparent"
                android:contentDescription="@string/widget_next"
                android:padding="5dp"
                android:src="@android:drawable/ic_media_next"
                android:tint="#FFFFDE59" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
